# --- AUDIRE privacy & data policy -------------------------------------------
# Raw / processed research data is NEVER tracked. Manifests are.
data/raw/
data/processed/
data/stimuli/
!data/manifests/
!data/manifests/**

# Participant-level private data must never enter Git.
private/
*.participant.json
*.participant.csv
profiles_local/

# Model weights / ASR caches
models/
.cache/
*.bin
*.ct2
*.onnx

# Experiment outputs (regenerated by `make reproduce`)
experiments/artifacts/
!experiments/artifacts/.gitkeep

# --- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / E2E -------------------------------------------------------------
node_modules/
test-results/
playwright-report/
.playwright/

# --- OS / editor ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
